{
  "$schema": "sslog_record_catalog.schema.json",
  "canonical_json": {
    "encoding": "UTF-8",
    "key_order": "lexicographic",
    "line_ending": "LF",
    "number_format": "shortest JSON decimal; integers remain integers",
    "terminal_newline": true,
    "whitespace": "none"
  },
  "capability_source_identity": {
    "instance_id": {
      "semantics": "zero-based instance within the record type's capability class; not a physical-device index",
      "unit": "capability-class index"
    },
    "physical_device_id": {
      "semantics": "groups capability descriptors supplied by the same physical module",
      "unit": "project physical-device id"
    },
    "reserved": {
      "semantics": "writer emits zero; reader assigns no meaning",
      "unit": "none"
    },
    "source_descriptor_id": {
      "semantics": "links this native capability record to DEVICE_DESCRIPTOR.descriptor_id",
      "unit": "project descriptor id"
    }
  },
  "catalog_schema_id": "silverstar.sslog.record-catalog/1.0",
  "endianness": "little",
  "field_contract": {
    "defaults": {
      "bitfield": null,
      "count": 1,
      "enum": null,
      "offset": 0,
      "quantity": "dimensionless",
      "scale": 1,
      "timestamp": false,
      "unit": "1",
      "validity": null
    },
    "semantic_rules": [
      {
        "quantity": "monotonic_time",
        "suffix": "_timestamp_us",
        "timestamp": true,
        "unit": "us"
      },
      {
        "quantity": "acceleration",
        "suffix": "_mps2",
        "unit": "m/s^2"
      },
      {
        "quantity": "angular_rate",
        "suffix": "_radps",
        "unit": "rad/s"
      },
      {
        "quantity": "velocity",
        "suffix": "_mps",
        "unit": "m/s"
      },
      {
        "quantity": "velocity_variance",
        "suffix": "_m2ps2",
        "unit": "m^2/s^2"
      },
      {
        "quantity": "variance_or_area",
        "suffix": "_m2",
        "unit": "m^2"
      },
      {
        "quantity": "magnetic_flux_density",
        "suffix": "_uT",
        "unit": "uT"
      },
      {
        "quantity": "pressure",
        "suffix": "_pa",
        "unit": "Pa"
      },
      {
        "quantity": "length",
        "suffix": "_m",
        "unit": "m"
      },
      {
        "quantity": "length",
        "suffix": "_cm",
        "unit": "cm"
      },
      {
        "quantity": "length",
        "suffix": "_mm",
        "unit": "mm"
      },
      {
        "quantity": "angle",
        "suffix": "_deg",
        "unit": "deg"
      },
      {
        "quantity": "temperature",
        "suffix": "_c",
        "unit": "degC"
      },
      {
        "bitfield": "record-specific mask",
        "quantity": "bit_mask",
        "suffix": "_mask"
      },
      {
        "bitfield": "record-specific flags",
        "quantity": "bit_mask",
        "suffix": "_flags"
      },
      {
        "quantity": "identifier",
        "suffix": "_id"
      },
      {
        "quantity": "count",
        "suffix": "_count"
      },
      {
        "name": "instance_id",
        "offset": 0,
        "quantity": "capability_instance",
        "scale": 1
      },
      {
        "name": "source_descriptor_id",
        "offset": 0,
        "quantity": "descriptor_reference",
        "scale": 1
      },
      {
        "enum": "FlightLogRecordType",
        "name": "record_type",
        "quantity": "enum"
      },
      {
        "bitfield": "record-specific validity",
        "name": "valid_mask",
        "quantity": "validity_mask",
        "validity": "fields selected by set bits"
      }
    ],
    "type_sizes": {
      "f32": 4,
      "i16": 2,
      "i32": 4,
      "i64": 8,
      "i8": 1,
      "pad": 1,
      "u16": 2,
      "u32": 4,
      "u64": 8,
      "u8": 1
    },
    "wire_order": "fields array order"
  },
  "format": "SSLOG0",
  "instance_routing_fields": [
    "source_descriptor_id",
    "instance_id"
  ],
  "max_payload_size": 256,
  "record_crc": "CRC-32/ISO-HDLC",
  "record_header_size": 24,
  "record_modes": {
    "ALGORITHM_DESCRIPTOR": "one-shot",
    "ALIGNMENT_RESULT": "event",
    "BARO_MEASUREMENT": "measurement",
    "BARO_NATIVE": "source-driven",
    "CALIBRATION_RESULT": "event",
    "DECODER_PROFILE_DESCRIPTOR": "one-shot",
    "DEVICE_DESCRIPTOR": "one-shot",
    "ESTIMATOR": "source-driven",
    "EVENT": "event",
    "GNSS_MEASUREMENT": "measurement",
    "GNSS_NATIVE": "source-driven",
    "HEALTH": "periodic",
    "HW_QUAT_NATIVE": "source-driven",
    "IMU_CORRECTED": "source-driven",
    "IMU_NATIVE": "source-driven",
    "INERTIAL_INCREMENT": "source-driven",
    "INITIAL_STATE": "one-shot",
    "KF6_DIAGNOSTIC": "source-driven",
    "KF6_FULL_P": "source-driven",
    "LOG_STREAM_DESCRIPTOR": "one-shot",
    "MAG_NATIVE": "source-driven",
    "MISSION_CONFIG": "one-shot",
    "POWER": "periodic",
    "PURE_INS": "source-driven",
    "RAW_SENSOR": "source-driven",
    "SAMPLE": "source-driven",
    "STATS": "periodic",
    "SYSTEM_CONFIG": "one-shot",
    "TELEMETRY_DIAG": "periodic"
  },
